# 网页版多用户部署时，API Key 由每个用户在登录后自己填写，不需要写在这里。
# 终端版 main.py 仍然从这个文件读取 OPENAI_API_KEY。
OPENAI_API_KEY=你的_API_Key
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat

# 注册人数上限，默认 200，可按部署规模调整。
MAX_USERS=200

# 可选：把 SQLite 数据库放到挂载卷上（容器部署时常用）。
# THESISAGENT_DB=/var/lib/thesisagent/memory.db
