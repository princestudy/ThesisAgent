# 论文知识库助手配置
# 项目文件里不再保存任何 API Key：网页版由每个用户在登录后自己输入（只存内存），
# 终端版 main.py 会在启动时提示输入。

# 接口地址：网页上不可见、也不可修改；运维可以用这里覆盖（例如换成中转网关）。
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat

# 注册人数上限，默认 200，可按部署规模调整。
MAX_USERS=200

# 每个用户最多保留几个对话，默认 2。
MAX_CONVERSATIONS=2

# 可选：固定管理员账号。配置后应用启动时自动创建该账号（或把已有同名账号提为管理员），
# 其他注册者一律是普通用户；不配置时，第一个注册者自动成为管理员。
# 注意：这里配的是"初始密码"，之后在网页上改密码不会被覆盖。
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=换成你自己的强密码

# 可选：注册邀请码。配置后注册必须填对，用来限制陌生人注册。
# INVITE_CODE=给我同学的口令

# 可选：把 SQLite 数据库放到挂载卷上（容器部署时常用）。
# THESISAGENT_DB=/var/lib/thesisagent/memory.db